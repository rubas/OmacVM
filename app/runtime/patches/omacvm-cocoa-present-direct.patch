+ * scaled, upside down, the buffer shown last flushed again) are drawn from the IOSurface
+ * as a RECTANGLE texture. TODO(revert: prototype only, not for main as it is).
+ */
+enum { PD_DIRECT, PD_SPLASH, PD_BRIGHT, PD_DEEP, PD_REGION, PD_SCALED, PD_UPSIDE,
+       PD_SAME, PD_TILES, PD_N };
