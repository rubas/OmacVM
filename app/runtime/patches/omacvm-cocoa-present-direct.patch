+static IOSurfaceRef present_direct_last;    /* QEMU thread: compared only */
+static uint64_t present_direct_n[PD_N];
+static int64_t present_direct_log_ns;
+static GLuint present_rect_prog, present_rect_vao, present_rect_vbo;
+static GLint present_rect_u_size, present_rect_u_flip;
+static int present_rect_made;
