+    }
+}
+
+/* present_ctx current: the program that draws a RECTANGLE texture as QEMU's blit. */
+static bool present_rect_program(void)
+{
+    static const GLfloat quad[] = { -1, -1, 1, -1, -1, 1, 1, 1 };
+    static const char *vert =
+        "#version 140\n"
+        "in vec2 in_position;\n"
+        "uniform vec2 size;\n"
+        "uniform float yflip;\n"
+        "out vec2 ex_tex_coord;\n"
+        "void main(void) {\n"
+        "    gl_Position = vec4(in_position, 0.0, 1.0);\n"
+        "    ex_tex_coord = vec2(1.0 + in_position.x, 1.0 + yflip * in_position.y) * 0.5 * size;\n"
+        "}\n";
+    static const char *frag =
+        "#version 140\n"
+        "uniform sampler2DRect image;\n"
+        "in vec2 ex_tex_coord;\n"
+        "out vec4 out_frag_color;\n"
+        "void main(void) {\n"
+        "    out_frag_color = texture(image, ex_tex_coord);\n"
+        "}\n";
+
+    if (present_rect_made) {
+        return present_rect_made > 0;
+    }
+    GLuint vs = omacvm_bright_shader(GL_VERTEX_SHADER, vert);
+    GLuint fs = omacvm_bright_shader(GL_FRAGMENT_SHADER, frag);
+    GLint ok = 0;
+    if (vs && fs) {
+        present_rect_prog = glCreateProgram();
+        glAttachShader(present_rect_prog, vs);
+        glAttachShader(present_rect_prog, fs);
+        glBindAttribLocation(present_rect_prog, 0, "in_position");
+        glLinkProgram(present_rect_prog);
+        glGetProgramiv(present_rect_prog, GL_LINK_STATUS, &ok);
+    }
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    if (!ok) {
+        present_rect_made = -1;
+        warn_report("cocoa: present-direct: no RECTANGLE program");
+        return false;
+    }
+    glUseProgram(present_rect_prog);
+    glUniform1i(glGetUniformLocation(present_rect_prog, "image"), 0);
+    present_rect_u_size = glGetUniformLocation(present_rect_prog, "size");
+    present_rect_u_flip = glGetUniformLocation(present_rect_prog, "yflip");
+    glGenVertexArrays(1, &present_rect_vao);
+    glBindVertexArray(present_rect_vao);
+    glGenBuffers(1, &present_rect_vbo);
+    glBindBuffer(GL_ARRAY_BUFFER, present_rect_vbo);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, 0);
+    glEnableVertexAttribArray(0);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glBindVertexArray(0);
+    present_rect_made = 1;
+    return true;
+}
+
+/*
+ * present_ctx current: the guest's IOSurface buffer drawn into the bound framebuffer.
+ * The texture goes right after the draw: a texture bound to an IOSurface keeps it in
+ * use (IOSurfaceIsInUse), and virgl holds the guest's writes while it is.
+ */
+static bool present_rect_blit(IOSurfaceRef s, bool flip, GLint filter)
+{
+    GLuint tex;
+    if (!present_rect_program()) {
+        return false;
+    }
+    glGenTextures(1, &tex);
+    glBindTexture(GL_TEXTURE_RECTANGLE, tex);
+    CGLTexImageIOSurface2D(present_ctx, GL_TEXTURE_RECTANGLE, GL_RGBA,
+                           IOSurfaceGetWidth(s), IOSurfaceGetHeight(s), GL_BGRA,
+                           GL_UNSIGNED_INT_8_8_8_8_REV, s, 0);
+    glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MAG_FILTER, filter);
+    glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MIN_FILTER, filter);
+    glUseProgram(present_rect_prog);
+    glUniform2f(present_rect_u_size, IOSurfaceGetWidth(s), IOSurfaceGetHeight(s));
+    glUniform1f(present_rect_u_flip, flip ? 1.0f : -1.0f);
+    glBindVertexArray(present_rect_vao);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glBindVertexArray(0);
+    glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+    glDeleteTextures(1, &tex);
+    return true;
+}
+
+/*
+ * OmacVM prototype test hook (OMACVM_TEST_PACE_CHECK=1, with tests/graphics/pacing's
+ * page and a second counter strip at the bottom): as each whole frame goes on the layer,
+ * read its counters from the surface (plain 8-bit surfaces only): top and bottom must
+ * agree (else the frame is torn), and the frame shown before must still hold the
+ * counter it had when it went up (else it was written while on screen). The marker
+ * cell's flips are logged for input latency (QMP keys toggle it).
+ */
+static int present_pace_on = -1;
+static struct {
+    IOSurfaceRef recent[4];             /* shown before, newest first (retained) */
+    uint64_t busy_older[4];             /* shows with 0, 1, 2, 3 older ones still in use */
+    IOSurfaceRef prev;
+    int prev_n;
+    int last_n, mark;
+    uint64_t shown, unread, torn, overwritten, steps[4];   /* steps: 0, 1, 2, more */
+    int64_t log_ns;
+} present_pace = { .last_n = -1, .mark = -1 };
+static os_unfair_lock present_pace_lock = OS_UNFAIR_LOCK_INIT;
+
+static int present_pace_lum(const uint8_t *base, size_t bpr, size_t w, size_t h, double x, double y)
+{
+    size_t xi = (size_t)x, yi = (size_t)y;
+    if (xi >= w || yi >= h) {
+        return -1;
+    }
+    const uint8_t *p = base + yi * bpr + xi * 4;
+    return (p[0] + p[1] + p[2]) / 3;
+}
+
+/* The counter of the strip at row y (cells of W/24), or -1. */
+static int present_pace_strip(const uint8_t *base, size_t bpr, size_t w, size_t h, double y)
+{
+    double cell = w / 24.0;
+    if (present_pace_lum(base, bpr, w, h, 1.5 * cell, y) < 200 ||
+        present_pace_lum(base, bpr, w, h, 18.5 * cell, y) > 60) {
+        return -1;
+    }
+    int v = 0;
+    for (int b = 0; b < 16; b++) {
+        if (present_pace_lum(base, bpr, w, h, (b + 2.5) * cell, y) > 128) {
+            v |= 1 << b;
+        }
+    }
+    return v;
+}
+
+static bool present_pace_read(IOSurfaceRef s, int *top, int *bottom, int *mark)
+{
+    if (IOSurfaceGetPixelFormat(s) != 'BGRA' ||
+        IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL) != kIOReturnSuccess) {
+        return false;
+    }
+    const uint8_t *base = IOSurfaceGetBaseAddress(s);
+    size_t bpr = IOSurfaceGetBytesPerRow(s), w = IOSurfaceGetWidth(s), h = IOSurfaceGetHeight(s);
+    double cell = w / 24.0;
+    *top = present_pace_strip(base, bpr, w, h, 1.5 * cell);
+    *bottom = present_pace_strip(base, bpr, w, h, h - 1.5 * cell);
+    int m = present_pace_lum(base, bpr, w, h, 1.5 * cell, 2.7 * cell);
+    *mark = m < 0 ? -1 : m > 128;
+    IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+    return true;
+}
+
+static void present_pace_check(IOSurfaceRef s)
+{
+    int top, bottom, mark;
+    if (present_pace_on < 0) {
+        present_pace_on = getenv("OMACVM_TEST_PACE_CHECK") != NULL;
+    }
+    if (!present_pace_on) {
+        return;
+    }
+    os_unfair_lock_lock(&present_pace_lock);
+    present_pace.shown++;
+    if (present_pace.prev && present_pace.prev != s && present_pace.prev_n >= 0) {
+        int pt, pb, pm;
+        if (present_pace_read(present_pace.prev, &pt, &pb, &pm) && pt >= 0 && pt != present_pace.prev_n) {
+            present_pace.overwritten++;
+        }
+    }
+    if (!present_pace_read(s, &top, &bottom, &mark) || top < 0) {
+        present_pace.unread++;
+        top = -1;
+    } else {
+        if (bottom >= 0 && bottom != top) {
+            present_pace.torn++;
+        }
+        if (present_pace.last_n >= 0) {
+            int d = (top - present_pace.last_n + 65536) % 65536;
+            present_pace.steps[d > 2 ? 3 : d]++;
+        }
+        present_pace.last_n = top;
+        if (mark >= 0 && present_pace.mark >= 0 && mark != present_pace.mark) {
+            info_report("cocoa: pace-check: marker %d shown", mark);
+        }
+        if (mark >= 0) {
+            present_pace.mark = mark;
+        }
+    }
+    int busy = 0;
+    for (int i = 0; i < 4; i++) {
+        bool seen = false;
+        for (int j = 0; j < i; j++) {
+            seen |= present_pace.recent[j] == present_pace.recent[i];
+        }
+        busy += !seen && present_pace.recent[i] && present_pace.recent[i] != s &&
+                IOSurfaceIsInUse(present_pace.recent[i]);
+    }
+    present_pace.busy_older[MIN(busy, 3)]++;
+    if (present_pace.recent[0] != s) {
+        if (present_pace.recent[3]) {
+            CFRelease(present_pace.recent[3]);
+        }
+        memmove(&present_pace.recent[1], &present_pace.recent[0], 3 * sizeof(IOSurfaceRef));
+        present_pace.recent[0] = (IOSurfaceRef)CFRetain(s);
+    }
+    if (present_pace.prev != s) {
+        if (present_pace.prev) {
+            CFRelease(present_pace.prev);
+        }
+        present_pace.prev = (IOSurfaceRef)CFRetain(s);
+    }
+    present_pace.prev_n = top;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    if (!present_pace.log_ns) {
+        present_pace.log_ns = now;
+    } else if (now - present_pace.log_ns >= 5 * NANOSECONDS_PER_SECOND) {
+        info_report("cocoa: pace-check: %" PRIu64 " shown, %" PRIu64 " unread, %" PRIu64
+                    " torn, %" PRIu64 " written while shown; counter steps 0/1/2/more: %"
+                    PRIu64 "/%" PRIu64 "/%" PRIu64 "/%" PRIu64 "; older buffers still in use at a "
+                    "show 0/1/2/3: %" PRIu64 "/%" PRIu64 "/%" PRIu64 "/%" PRIu64 " in 5 s",
+                    present_pace.shown, present_pace.unread, present_pace.torn,
+                    present_pace.overwritten, present_pace.steps[0], present_pace.steps[1],
+                    present_pace.steps[2], present_pace.steps[3], present_pace.busy_older[0],
+                    present_pace.busy_older[1], present_pace.busy_older[2],
+                    present_pace.busy_older[3]);
+        memset(present_pace.busy_older, 0, sizeof(present_pace.busy_older));
+        present_pace.shown = present_pace.unread = present_pace.torn = present_pace.overwritten = 0;
+        memset(present_pace.steps, 0, sizeof(present_pace.steps));
+        present_pace.log_ns = now;
+    }
+    os_unfair_lock_unlock(&present_pace_lock);
+}
