+#ifdef ENABLE_METAL
+/*
+ * OmacVM (present-direct-surface prototype, OMACVM_SCANOUT_IOSURFACE=1): a single-level
+ * 8-bit BGRA/BGRX 2D buffer the guest made for scanout lives in an IOSurface, bound as a
+ * RECTANGLE texture: everything that writes or reads it through framebuffers works as
+ * before, and QEMU puts the IOSurface itself on the window (no copy). Samplers cannot
+ * read a RECTANGLE texture as 2D, so they read a 2D shadow, copied when a draw samples
+ * the buffer. A write into the buffer waits (bounded) while Core Animation still shows
+ * it or QEMU's present queue holds it: the guest's page flip does not wait for the Mac.
+ */
+static int vrend_scanout_iosurface_on = -1;
+#define VREND_SCANOUT_HOLD_MAX_US 25000
+static struct {
+   uint64_t buffers, holds, timeouts, refreshes, writes, renames, spares;
+   uint64_t hold_us_sum, hold_us_max;
+   uint32_t hist[8];   /* holds of <0.1, <0.5, <1, <2, <4, <8, <16, >=16 ms */
+   uint64_t last_log_us;
+} vrend_scanout_stats;
+
+static uint64_t vrend_scanout_now_us(void)
+{
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return (uint64_t)t.tv_sec * 1000000 + t.tv_nsec / 1000;
+}
+
+static void vrend_scanout_stats_tick(void)
+{
+   uint64_t now = vrend_scanout_now_us();
+   if (!vrend_scanout_stats.last_log_us) {
+      vrend_scanout_stats.last_log_us = now;
+      return;
+   }
+   if (now - vrend_scanout_stats.last_log_us < 5000000)
+      return;
+   vrend_scanout_stats.last_log_us = now;
+   const uint32_t *h = vrend_scanout_stats.hist;
+   fprintf(stderr, "omacvm-scanout: %" PRIu64 " writes, %" PRIu64 " held (%" PRIu64 " us total, max %" PRIu64
+           " us; <0.1/0.5/1/2/4/8/16/more ms: %u/%u/%u/%u/%u/%u/%u/%u), %" PRIu64 " timeouts, %" PRIu64
+           " moved to another IOSurface (copied; %" PRIu64 " spares made in all), %" PRIu64
+           " shadow copies in 5 s\n",
+           vrend_scanout_stats.writes, vrend_scanout_stats.holds, vrend_scanout_stats.hold_us_sum,
+           vrend_scanout_stats.hold_us_max, h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7],
+           vrend_scanout_stats.timeouts, vrend_scanout_stats.renames, vrend_scanout_stats.spares,
+           vrend_scanout_stats.refreshes);
+   uint64_t buffers = vrend_scanout_stats.buffers, last = vrend_scanout_stats.last_log_us;
+   uint64_t spares = vrend_scanout_stats.spares;
+   memset(&vrend_scanout_stats, 0, sizeof(vrend_scanout_stats));
+   vrend_scanout_stats.buffers = buffers;
+   vrend_scanout_stats.spares = spares;
+   vrend_scanout_stats.last_log_us = last;
+}
+
+static bool vrend_scanout_iosurface_alloc(struct vrend_resource *gr, enum virgl_formats format)
+{
+   const struct pipe_resource *pr = &gr->base;
+
+   if (vrend_scanout_iosurface_on < 0) {
+      const char *e = getenv("OMACVM_SCANOUT_IOSURFACE");
+      vrend_scanout_iosurface_on = e && !strcmp(e, "1");
+      if (vrend_scanout_iosurface_on)
+         fprintf(stderr, "omacvm-scanout: 8-bit scanout buffers are IOSurfaces (OMACVM_SCANOUT_IOSURFACE=1)\n");
+   }
+   if (!vrend_scanout_iosurface_on || !(pr->bind & VIRGL_RES_BIND_SCANOUT) ||
+       pr->target != PIPE_TEXTURE_2D || pr->last_level != 0 || pr->nr_samples > 1 ||
+       pr->array_size > 1 || pr->depth0 != 1 || !pr->width0 || !pr->height0 ||
+       pr->width0 > 16384 || pr->height0 > 16384 ||
+       (format != VIRGL_FORMAT_B8G8R8X8_UNORM && format != VIRGL_FORMAT_B8G8R8A8_UNORM))
+      return false;
+
+   void *surface = virgl_metal_scanout_iosurface_create(pr->width0, pr->height0);
+   if (!surface)
+      return false;
+   GLuint tex;
+   unsigned w, h;
+   glGenTextures(1, &tex);
+   glBindTexture(GL_TEXTURE_RECTANGLE, tex);
+   if (!virgl_metal_iosurface_bind_rect(surface, &w, &h) || w != pr->width0 || h != pr->height0) {
+      glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+      glDeleteTextures(1, &tex);
+      virgl_metal_iosurface_release(surface);
+      fprintf(stderr, "omacvm-scanout: a %ux%u IOSurface could not be bound: a plain texture\n",
+              pr->width0, pr->height0);
+      return false;
+   }
+   glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+   glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+   glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+   gr->gl_id = tex;
+   gr->target = GL_TEXTURE_RECTANGLE;
+   gr->storage_bits &= ~VREND_STORAGE_GL_IMMUTABLE;
+   gr->storage_bits |= VREND_STORAGE_GL_TEXTURE;
+   gr->scanout_iosurface = surface;
+   if (vrend_scanout_stats.buffers++ < 8)
+      fprintf(stderr, "omacvm-scanout: buffer %ux%u %s y_0_top %d is an IOSurface\n", pr->width0,
+              pr->height0, util_format_name(pr->format), gr->y_0_top);
+   return true;
+}
+
+/* The 2D copy samplers read (made the first time, empty until refreshed). */
+static GLuint vrend_scanout_shadow(struct vrend_resource *res)
+{
+   if (!res->scanout_shadow) {
+      GLint bound = 0;
+      glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+      glGenTextures(1, &res->scanout_shadow);
+      glBindTexture(GL_TEXTURE_2D, res->scanout_shadow);
+      glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, res->base.width0, res->base.height0, 0,
+                   GL_BGRA, GL_UNSIGNED_BYTE, NULL);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_BASE_LEVEL, 0);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+      glBindTexture(GL_TEXTURE_2D, bound);
+   }
+   return res->scanout_shadow;
+}
+
+/* A draw samples the buffer: copy it into the shadow (once per submit). GL state kept. */
+static void vrend_scanout_shadow_refresh(struct vrend_resource *res, const GLint *swizzle)
+{
+   GLuint shadow = vrend_scanout_shadow(res);
+   if (res->scanout_shadow_serial != vrend_submit_serial) {
+      res->scanout_shadow_serial = vrend_submit_serial;
+      GLint rfb = 0, dfb = 0;
+      GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+      GLuint fb[2];
+      glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &rfb);
+      glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &dfb);
+      glGenFramebuffers(2, fb);
+      glBindFramebuffer(GL_READ_FRAMEBUFFER, fb[0]);
+      glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE,
+                             res->gl_id, 0);
+      glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fb[1]);
+      glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, shadow, 0);
+      if (scissor)
+         glDisable(GL_SCISSOR_TEST);
+      glBlitFramebuffer(0, 0, res->base.width0, res->base.height0, 0, 0, res->base.width0,
+                        res->base.height0, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+      if (scissor)
+         glEnable(GL_SCISSOR_TEST);
+      glBindFramebuffer(GL_READ_FRAMEBUFFER, rfb);
+      glBindFramebuffer(GL_DRAW_FRAMEBUFFER, dfb);
+      glDeleteFramebuffers(2, fb);
+      vrend_scanout_stats.refreshes++;
+   }
+   if (swizzle) {
+      GLint bound = 0;
+      glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+      glBindTexture(GL_TEXTURE_2D, shadow);
+      for (unsigned c = 0; c < 4; ++c)
+         glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R + c, swizzle[c]);
+      glBindTexture(GL_TEXTURE_2D, bound);
+   }
+   vrend_scanout_stats_tick();
+}
+
+/*
+ * The buffer still in use moves to a free IOSurface (a spare, or a new one: at most two
+ * per buffer) with its picture copied on the GPU: the guest draws only what changed into
+ * its buffers. GL state kept. False when no IOSurface is free.
+ */
+static bool vrend_scanout_move(struct vrend_resource *res)
+{
+   int k;
+   for (k = 0; k < 2; k++) {
+      if (!res->scanout_spare[k]) {
+         res->scanout_spare[k] = virgl_metal_scanout_iosurface_create(res->base.width0,
+                                                                      res->base.height0);
+         vrend_scanout_stats.spares += res->scanout_spare[k] != NULL;
+      }
+      if (res->scanout_spare[k] && !virgl_metal_iosurface_in_use(res->scanout_spare[k]))
+         break;
+   }
+   if (k == 2)
+      return false;
+   void *from = res->scanout_iosurface, *to = res->scanout_spare[k];
+   GLint rfb = 0, dfb = 0, bound = 0;
+   GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+   GLuint tex[2], fb[2];
+   unsigned w, h;
+   bool ok;
+   glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &rfb);
+   glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &dfb);
+   glGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE, &bound);
+   glGenTextures(2, tex);
+   glBindTexture(GL_TEXTURE_RECTANGLE, tex[0]);
+   ok = virgl_metal_iosurface_bind_rect(from, &w, &h);
+   glBindTexture(GL_TEXTURE_RECTANGLE, tex[1]);
+   ok = ok && virgl_metal_iosurface_bind_rect(to, &w, &h);
+   if (ok) {
+      glGenFramebuffers(2, fb);
+      glBindFramebuffer(GL_READ_FRAMEBUFFER, fb[0]);
+      glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE, tex[0], 0);
+      glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fb[1]);
+      glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_RECTANGLE, tex[1], 0);
+      if (scissor)
+         glDisable(GL_SCISSOR_TEST);
+      glBlitFramebuffer(0, 0, w, h, 0, 0, w, h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+      if (scissor)
+         glEnable(GL_SCISSOR_TEST);
+      glBindFramebuffer(GL_READ_FRAMEBUFFER, rfb);
+      glBindFramebuffer(GL_DRAW_FRAMEBUFFER, dfb);
+      glDeleteFramebuffers(2, fb);
+      /* the buffer's own texture now stands on the new IOSurface */
+      glBindTexture(GL_TEXTURE_RECTANGLE, res->gl_id);
+      ok = virgl_metal_iosurface_bind_rect(to, &w, &h);
+   }
+   glBindTexture(GL_TEXTURE_RECTANGLE, bound);
+   glDeleteTextures(2, tex);
+   if (!ok)
+      return false;
+   res->scanout_spare[k] = from;
+   res->scanout_iosurface = to;
+   vrend_scanout_stats.renames++;
+   return true;
 }
 
+/*
+ * The guest is about to write the buffer. Its page flip completed in the guest without
+ * waiting for the Mac, so the buffer may still be on the window, about to go there, or
+ * still held by WindowServer: move it to a free IOSurface (true), else wait until
+ * nothing uses it (at most 25 ms, then write).
+ */
+static bool vrend_scanout_write_hold(struct vrend_resource *res)
+{
+   if (!res || !res->scanout_iosurface)
+      return false;
+   vrend_scanout_stats.writes++;
+   if (virgl_metal_iosurface_in_use(res->scanout_iosurface) && vrend_scanout_move(res)) {
+      vrend_scanout_stats_tick();
+      return true;
+   }
+   if (virgl_metal_iosurface_in_use(res->scanout_iosurface)) {
+      uint64_t t0 = vrend_scanout_now_us(), dt = 0;
+      bool busy = true;
+      while (busy && dt < VREND_SCANOUT_HOLD_MAX_US) {
+         usleep(100);
+         busy = virgl_metal_iosurface_in_use(res->scanout_iosurface);
+         dt = vrend_scanout_now_us() - t0;
+      }
+      static const uint64_t edges[7] = { 100, 500, 1000, 2000, 4000, 8000, 16000 };
+      unsigned b = 0;
+      while (b < 7 && dt >= edges[b])
+         b++;
+      vrend_scanout_stats.hist[b]++;
+      vrend_scanout_stats.holds++;
+      vrend_scanout_stats.hold_us_sum += dt;
+      vrend_scanout_stats.hold_us_max = MAX2(vrend_scanout_stats.hold_us_max, dt);
+      vrend_scanout_stats.timeouts += busy;
+   }
+   vrend_scanout_stats_tick();
+   return false;
+}
