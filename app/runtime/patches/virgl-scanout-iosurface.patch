+   CFDictionaryRef props = CFDictionaryCreate(NULL, keys, (const void **)numbers, 4,
+                                              &kCFTypeDictionaryKeyCallBacks,
+                                              &kCFTypeDictionaryValueCallBacks);
+   IOSurfaceRef surface = IOSurfaceCreate(props);
+   CFRelease(props);
+   for (int i = 0; i < 4; i++)
