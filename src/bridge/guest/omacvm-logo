#!/bin/bash
# omacvm-logo: the lit Apple logo on the lid of the Mac (a MacBook Pro that
# has one), from the VM (feature logo-light, through OmacVM Bridge).
#   omacvm-logo                  the mode that plays, as the words that set it again
#   omacvm-logo auto             macOS lights it, as without OmacVM (it follows the room)
#   omacvm-logo off              dark
#   omacvm-logo on [1-100]       steady, that bright as the eye sees it (default 50)
#   omacvm-logo breathe [6-30]   breathes, that many breaths a minute (default 15)
# The Mac plays it and fades every change over 3 s. The logo is dark while the
# Mac's display sleeps or its lid is closed, and the mode plays again after.
# It goes back to auto when this VM stops, or when the Bridge stops.
# Exit: 0 done, 1 the Mac's side failed or cannot be reached (try again),
# 2 usage, 3 the Mac has no lit logo (or the logo light is off on the Mac).
set -uo pipefail
usage() { sed -n '4,8s/^# \{0,1\}//p' "$0" >&2; exit 2; }
# A whole number in range (no sign, no point); the Mac checks it again.
number() { [[ $1 =~ ^[0-9]{1,3}$ ]] && (( 10#$1 >= $2 && 10#$1 <= $3 )) || usage; echo $((10#$1)); }
n=""
case $# in
  0) ;;
  1|2)
    case $1 in
      auto|off) (( $# == 1 )) || usage ;;
      on) (( $# == 1 )) || n=$(number "$2" 1 100) || exit 2 ;;
      breathe) (( $# == 1 )) || n=$(number "$2" 6 30) || exit 2 ;;
      *) usage ;;
    esac ;;
  *) usage ;;
esac
case ${1:-} in
  "") body="" ;;
  auto|off) body="{\"mode\": \"$1\"}" ;;
  on) body="{\"mode\": \"on\"${n:+, \"percent\": $n}}" ;;
  breathe) body="{\"mode\": \"breathe\"${n:+, \"rate\": $n}}" ;;
esac

e=$(mktemp); trap 'rm -f "$e"' EXIT
out=$(omacvm-bridge logo "$body" 2>"$e"); rc=$?
if (( rc == 0 )); then
  [[ -n $body ]] || jq -r '[.mode, (.percent // .rate // empty | tostring)] | join(" ")' <<<"$out"
  exit 0
fi
# An answer from the Bridge (curl's --fail-with-body): its {"error", "code"} on stdout.
code=$(jq -r '.code // empty' <<<"$out" 2>/dev/null) || code=""
why=$(jq -r '.error // empty' <<<"$out" 2>/dev/null) || why=""
case $code in
  no-logo|off) echo "omacvm-logo: $why" >&2; exit 3 ;;
esac
[[ -n $why ]] || why=$(grep -v '^curl: (22)' "$e" | tail -1)
[[ -n $why ]] || why="OmacVM Bridge on the Mac did not answer"
echo "omacvm-logo: $why" >&2
exit 1
